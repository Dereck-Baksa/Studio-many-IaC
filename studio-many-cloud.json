{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "InfraestruturaStudioMany",
  "Resources": {
    "StudioManyVpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.0.0.0/26",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-VPC"
          }
        ]
      }
    },
    "StudioManyInternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-InternetGateway"
          }
        ]
      }
    },
    "AttachGateway": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "StudioManyVpc"
        },
        "InternetGatewayId": {
          "Ref": "StudioManyInternetGateway"
        }
      }
    },

    "StudioManySubnetPublicaLB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StudioManyVpc"
        },
        "CidrBlock": "10.0.0.0/27",
        "AvailabilityZone": "us-east-1a",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-subnet-publica-LB"
          }
        ]
      }
    },

    "StudioManySubnetPrivadaFront": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StudioManyVpc"
        },
        "CidrBlock": "10.0.0.0/27",
        "AvailabilityZone": "us-east-1a",
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-subnet-publica-Front"
          }
        ]
      }
    },

    "StudioManySubnetPrivadaBackEnd": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StudioManyVpc"
        },
        "CidrBlock": "10.0.0.32/27",
        "AvailabilityZone": "us-east-1a",
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-subnet-privada-BackEnd"
          }
        ]
      }
    },

    "StudioManySubnetPrivadaDB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "StudioManyVpc"
        },
        "CidrBlock": "10.0.0.32/27",
        "AvailabilityZone": "us-east-1a",
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-subnet-privada-DB"
          }
        ]
      }
    },

    "StudioManyElasticIP": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "AttachGateway",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-ip-elastico"
          }
        ]
      }
    },
    
    "StudioManyNatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "SubnetId": {
          "Ref": "StudioManySubnetPublicaLB"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "StudioManyElasticIP",
            "AllocationId"
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-nat-gateway"
          }
        ]
      }
    },

    "StudioManyRouteTablePublicaLB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "StudioManyVpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "Studio-many-route-table-publica-LB"
          }
        ]
      }
    },

    "StudioManyRotaPublicaLB": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "AttachGateway",
      "Properties": {
        "RouteTableId": {
          "Ref": "StudioManyRouteTablePublicaLB"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "StudioManyInternetGateway"
        }
      }
    },

    "AssociacaoPublica": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "StudioManySubnetPublicaLB"
        },
        "RouteTableId": {
          "Ref": "StudioManyRouteTablePublicaLB"
        }
