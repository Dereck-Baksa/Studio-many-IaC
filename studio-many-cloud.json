  {
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "InfraestruturaStudioMany - Sem NAT",
    "Resources": {
      "StudioManyVpc": {
        "Type": "AWS::EC2::VPC",
        "Properties": {
          "CidrBlock": "10.0.0.0/22",
          "EnableDnsSupport": true,
          "EnableDnsHostnames": true,
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-VPC"
            }
          ]
        }
      },
      "StudioManyInternetGateway": {
        "Type": "AWS::EC2::InternetGateway",
        "Properties": {
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-InternetGateway"
            }
          ]
        }
      },
      "AttachGateway": {
        "Type": "AWS::EC2::VPCGatewayAttachment",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "InternetGatewayId": {
            "Ref": "StudioManyInternetGateway"
          }
        }
      },
      "StudioManySubnetPublicaFrontA": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "CidrBlock": "10.0.1.0/27",
          "AvailabilityZone": "us-east-1a",
          "MapPublicIpOnLaunch": true,
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-subnet-publica-A"
            }
          ]
        }
      },
      "StudioManySubnetPublicaFrontB": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "CidrBlock": "10.0.1.32/27",
          "AvailabilityZone": "us-east-1b",
          "MapPublicIpOnLaunch": true,
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-subnet-publica-B"
            }
          ]
        }
      },
      "StudioManySubnetPrivadaBackA": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "CidrBlock": "10.0.2.0/27",
          "AvailabilityZone": "us-east-1a",
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-subnet-privada-Back-A"
            }
          ]
        }
      },
      "StudioManySubnetPrivadaBackB": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "CidrBlock": "10.0.2.32/27",
          "AvailabilityZone": "us-east-1b",
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-subnet-privada-Back-B"
            }
          ]
        }
      },
      "StudioManySubnetPrivadaDB": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "CidrBlock": "10.0.3.0/27",
          "AvailabilityZone": "us-east-1a",
          "Tags": [
            {
              "Key": "Name",
              "Value": "Studio-many-subnet-privada-DB"
            }
          ]
        }
      },
      "StudioManyRouteTablePublica": {
        "Type": "AWS::EC2::RouteTable",
        "Properties": {
          "VpcId": {
            "Ref": "StudioManyVpc"
          }
        }
      },
      "StudioManyRouteInternet": {
        "Type": "AWS::EC2::Route",
        "DependsOn": "AttachGateway",
        "Properties": {
          "RouteTableId": {
            "Ref": "StudioManyRouteTablePublica"
          },
          "DestinationCidrBlock": "0.0.0.0/0",
          "GatewayId": {
            "Ref": "StudioManyInternetGateway"
          }
        }
      },
      "AssociacaoPublicaA": {
        "Type": "AWS::EC2::SubnetRouteTableAssociation",
        "Properties": {
          "SubnetId": {
            "Ref": "StudioManySubnetPublicaFrontA"
          },
          "RouteTableId": {
            "Ref": "StudioManyRouteTablePublica"
          }
        }
      },
      "AssociacaoPublicaB": {
        "Type": "AWS::EC2::SubnetRouteTableAssociation",
        "Properties": {
          "SubnetId": {
            "Ref": "StudioManySubnetPublicaFrontB"
          },
          "RouteTableId": {
            "Ref": "StudioManyRouteTablePublica"
          }
        }
      },
      "StudioManySecurityGroupHTTP": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
          "GroupDescription": "HTTP e SSH",
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "SecurityGroupIngress": [
            {
              "IpProtocol": "tcp",
              "FromPort": 22,
              "ToPort": 22,
              "CidrIp": "0.0.0.0/0"
            },
            {
              "IpProtocol": "tcp",
              "FromPort": 80,
              "ToPort": 80,
              "CidrIp": "0.0.0.0/0"
            },
            {
              "IpProtocol": "tcp",
              "FromPort": 8080,
              "ToPort": 8080,
              "CidrIp": "0.0.0.0/0"
            }
          ]
        }
      },
      "StudioManyEC2FrontA": {
        "Type": "AWS::EC2::Instance",
        "Properties": {
          "ImageId": "ami-0c02fb55956c7d316",
          "InstanceType": "t3.micro",
          "SubnetId": {
            "Ref": "StudioManySubnetPublicaFrontA"
          },
          "SecurityGroupIds": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "KeyName": "studio-many-chave",              
          "PrivateIpAddress": "10.0.1.2"
        }
      },
      "StudioManyEC2FrontB": {
        "Type": "AWS::EC2::Instance",
        "Properties": {
          "ImageId": "ami-0c02fb55956c7d316",
          "InstanceType": "t3.micro",
          "SubnetId": {
            "Ref": "StudioManySubnetPublicaFrontB"
          },
          "SecurityGroupIds": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "KeyName": "studio-many-chave",   
          "PrivateIpAddress": "10.0.1.34"
        }
      },
      "StudioManyEC2BackA": {
        "Type": "AWS::EC2::Instance",
        "Properties": {
          "ImageId": "ami-0c02fb55956c7d316",
          "InstanceType": "t3.micro",
          "SubnetId": {
            "Ref": "StudioManySubnetPrivadaBackA"
          },
          "SecurityGroupIds": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "KeyName": "studio-many-chave",
          "PrivateIpAddress": "10.0.2.2"
        }
      },
      "StudioManyEC2BackB": {
        "Type": "AWS::EC2::Instance",
        "Properties": {
          "ImageId": "ami-0c02fb55956c7d316",
          "InstanceType": "t3.micro",
          "SubnetId": {
            "Ref": "StudioManySubnetPrivadaBackB"
          },
          "SecurityGroupIds": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "KeyName": "studio-many-chave",
          "PrivateIpAddress": "10.0.2.34"
        }
      },
      "StudioManyEC2DB": {
        "Type": "AWS::EC2::Instance",
        "Properties": {
          "ImageId": "ami-0c02fb55956c7d316",
          "InstanceType": "t3.micro",
          "SubnetId": {
            "Ref": "StudioManySubnetPrivadaDB"
          },
          "SecurityGroupIds": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "KeyName": "studio-many-chave",
          "PrivateIpAddress": "10.0.3.2"
        }
      },
      "StudioManyLoadbalancerPublico": {
        "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
        "Properties": {
          "Name": "StudioManyLBPublico",
          "Subnets": [
            {
              "Ref": "StudioManySubnetPublicaFrontA"
            },
            {
              "Ref": "StudioManySubnetPublicaFrontB"
            }
          ],
          "SecurityGroups": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "Scheme": "internet-facing",
          "Type": "application"
        }
      },
      "StudioManyTargetGroupFront": {
        "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
        "Properties": {
          "Name": "StudioManyTGFront",
          "Port": 80,
          "Protocol": "HTTP",
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "TargetType": "instance",
          "Targets": [
            {
              "Id": {
                "Ref": "StudioManyEC2FrontA"
              }
            },
            {
              "Id": {
                "Ref": "StudioManyEC2FrontB"
              }
            }
          ]
        }
      },
      "StudioManyListenerFront": {
        "Type": "AWS::ElasticLoadBalancingV2::Listener",
        "Properties": {
          "LoadBalancerArn": {
            "Ref": "StudioManyLoadbalancerPublico"
          },
          "Port": 80,
          "Protocol": "HTTP",
          "DefaultActions": [
            {
              "Type": "forward",
              "TargetGroupArn": {
                "Ref": "StudioManyTargetGroupFront"
              }
            }
          ]
        }
      },
      "StudioManyLoadbalancerPrivado": {
        "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
        "Properties": {
          "Name": "StudioManyLBPrivado",
          "Subnets": [
            {
              "Ref": "StudioManySubnetPrivadaBackA"
            },
            {
              "Ref": "StudioManySubnetPrivadaBackB"
            }
          ],
          "SecurityGroups": [
            {
              "Ref": "StudioManySecurityGroupHTTP"
            }
          ],
          "Scheme": "internet-facing",
          "Type": "application"
        }
      },
      "StudioManyTargetGroupBack": {
        "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
        "Properties": {
          "Name": "StudioManyTG",
          "Port": 80,
          "Protocol": "HTTP",
          "VpcId": {
            "Ref": "StudioManyVpc"
          },
          "TargetType": "instance",
          "Targets": [
            {
              "Id": {
                "Ref": "StudioManyEC2BackA"
              }
            },
            {
              "Id": {
                "Ref": "StudioManyEC2BackB"
              }
            }
          ]
        }
      },
      "StudioManyListenerBack": {
        "Type": "AWS::ElasticLoadBalancingV2::Listener",
        "Properties": {
          "LoadBalancerArn": {
            "Ref": "StudioManyLoadbalancerPrivado"
          },
          "Port": 80,
          "Protocol": "HTTP",
          "DefaultActions": [
            {
              "Type": "forward",
              "TargetGroupArn": {
                "Ref": "StudioManyTargetGroupBack"
              }
            }
          ]
        }
      }
    }
  }